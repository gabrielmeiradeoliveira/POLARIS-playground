{
  "name": "polaris-playground",
  "version": "0.1.0",
  "private": true,
  "description": "Microservico de documentos, usuarios e relatorios para o laboratorio POLARIS",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
